{
  "name": "ai-qa-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Catch the bugs AI writes. The AI suggests, the tests decide.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.14.0",
  "bin": {
    "sentinel": "./dist/cli.js"
  },
  "scripts": {
    "sentinel": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "selfscan": "tsx src/cli.ts scan ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fastify": "^5.12.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  }
}
